# PostgreSQL connection used by @wpas/db (MikroORM)
DATABASE_URL=postgresql://wpas:wpas@localhost:5432/wpas

# Connection pool (optional)
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# Logging: fatal | error | warn | info | debug | trace | silent (optional, default info)
LOG_LEVEL=info

# Error reporting (optional; leave empty to disable). Server and browser DSNs.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
