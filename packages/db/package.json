{
  "name": "@wpas/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "orm": "tsx --env-file-if-exists=../../.env ../../node_modules/@mikro-orm/cli/cli.js",
    "migration:create": "npm run orm -- migration:create",
    "migration:up": "npm run orm -- migration:up",
    "migration:down": "npm run orm -- migration:down",
    "migration:pending": "npm run orm -- migration:pending"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@wpas/core": "*"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@testcontainers/postgresql": "^12.2.1",
    "tsx": "^4",
    "vitest": "^5.0.5"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts"
    ]
  }
}
