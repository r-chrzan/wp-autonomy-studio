{
  "name": "wp-autonomy-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "dev": "npm run dev -w @wpas/app",
    "build": "npm run build -w @wpas/app",
    "start": "npm run start -w @wpas/app",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "knip": "knip",
    "test": "vitest run --project 'unit-*'",
    "test:watch": "vitest --project 'unit-*'",
    "test:integration": "npm run build && vitest run --project integration",
    "test:coverage": "vitest run --project 'unit-*' --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run test:coverage",
    "prepare": "lefthook install",
    "db:migration:create": "npm run migration:create -w @wpas/db --",
    "db:migration:up": "npm run migration:up -w @wpas/db",
    "db:migration:down": "npm run migration:down -w @wpas/db",
    "db:migration:pending": "npm run migration:pending -w @wpas/db"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "@wpas/db": "*",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.1",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
